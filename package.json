{
  "name": "coinflow",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "verify": "pnpm --filter web verify",
    "db:up": "docker compose up -d --wait",
    "db:generate": "pnpm --filter web db:generate",
