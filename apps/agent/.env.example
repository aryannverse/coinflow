# Shared with apps/web/.env.local (same value on both sides). Generated by the Task 3 setup step.
AGENT_SHARED_SECRET=
# Where the agent reaches Coinflow (Next). In docker compose this is http://host.docker.internal:3000.
COINFLOW_API_URL=http://localhost:3000
# Postgres for LangGraph threads (schema "agent" is created on start). On Vercel: Neon's DIRECT (unpooled) URL, ?sslmode=require.
AGENT_DATABASE_URL=postgresql://coinflow:coinflow@localhost:5436/coinflow
CHECKPOINTER=postgres
# Any OpenAI-compatible chat model (spec §4.1). The project uses Groq. Leave LLM_API_KEY blank and the pill shows "Assistant offline".
LLM_BASE_URL=https://api.groq.com/openai/v1
# Your Groq API key (gsk_…). Never commit it.
LLM_API_KEY=
# Chat, tools and the planner: a production Groq model with tool use and strict structured outputs (120b: same free-tier limit as 20b, much better tool use — live check 2026-10-13).
LLM_MODEL=openai/gpt-oss-120b
# Receipts: Groq's vision model (preview; strict json_schema). Blank → receipt scan returns vision_unavailable.
LLM_VISION_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_S=60
# Receipt JSON: json_object (default; works on Groq's qwen) or json_schema (strict schema, for other endpoints).
RECEIPT_JSON_MODE=
# Trip/event planner: light (default; fits Groq's free-tier tokens per minute) or deep (Deep Agents, spec §4.3).
PLANNER_ENGINE=
# Speech-to-text: local (faster-whisper, needs the speech extra; the default) or groq (whisper-large-v3-turbo, used on Vercel).
STT_PROVIDER=
# Read-aloud: local (Kokoro, needs the speech extra; the default) or groq (Orpheus, used on Vercel).
TTS_PROVIDER=
# Local faster-whisper model and precision (STT_PROVIDER=local only).
STT_MODEL=small
STT_COMPUTE_TYPE=int8
# Optional ISO-639-1 hint for either provider, e.g. en. Blank: auto-detect.
STT_LANGUAGE=
# Blank: af_heart (Kokoro) locally, hannah (Orpheus) on Groq. Orpheus voices: autumn, diana, hannah, austin, daniel, troy.
TTS_VOICE=
COACH_ENABLED=true
# Coach timing: scheduler (APScheduler in this process; the default, local and docker) or cron (Vercel Cron calls /coach/run).
COACH_MODE=
# Cron mode only: Vercel sends "Authorization: Bearer $CRON_SECRET" to /coach/run. Random, ≥ 32 characters.
CRON_SECRET=
