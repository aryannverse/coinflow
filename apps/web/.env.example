# Postgres (docker compose, host port 5436)
DATABASE_URL=postgres://coinflow:coinflow@localhost:5436/coinflow

# Clerk — written into .env.local by `npx clerk init` (Task 2). Never commit real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional locally: users are also synced lazily on first request
CLERK_WEBHOOK_SIGNING_SECRET=

# Test users (Clerk dev instance). E2E_* signs in for Playwright specs; DEMO_* is the seeded demo user
# that `pnpm shot:landing` signs in as. Emails only, never passwords.
E2E_CLERK_USER_EMAIL=
DEMO_CLERK_USER_EMAIL=

# Local file storage for UPI QR uploads
UPLOADS_DIR=./uploads

APP_URL=http://localhost:3000
# Invite links (Part B): random secret, ≥ 32 chars. Tokens are HMAC(INVITE_SECRET, invite id); only their hash is stored.
INVITE_SECRET=
LOG_LEVEL=info
# Part C: the agent service (apps/agent). AGENT_SHARED_SECRET must equal apps/agent/.env's value.
AGENT_URL=http://127.0.0.1:8100
AGENT_SHARED_SECRET=
